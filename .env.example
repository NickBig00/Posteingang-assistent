# Copy to .env and fill in locally. Never commit .env.

# Application title in the page header (default: Posteingangs-Assistent).
APP_TITLE=Posteingangs-Assistent
# Brand colour of the interface as hex (default: #0f766e). Text contrast is adjusted automatically.
BRAND_COLOR=#0f766e

# Enabled modules, comma-separated (default: all = inbox,social).
MODULES=inbox,social

# Active industry profile (file profiles/<PROFILE>.yaml).
PROFILE=fitness

# Social media: brand profile (file <BRAND_PROFILES_DIR>/<BRAND_PROFILE>.yaml).
# Profiles of real customers live outside the repository.
BRAND_PROFILE=demo
BRAND_PROFILES_DIR=profiles/brand

# LLM provider: "fake" (offline, deterministic), "anthropic" or "openai".
LLM_PROVIDER=fake
# Model of the selected provider. Anthropic default: claude-opus-5-5.
# For LLM_PROVIDER=openai this is required: set an OpenAI model name.
LLM_MODEL=claude-opus-5-5

# Only for LLM_PROVIDER=anthropic – leave empty in the repository.
ANTHROPIC_API_KEY=
LLM_EFFORT=medium
# On a refusal, let another Claude model answer (model actually used is audited). Default: off.
LLM_FALLBACK=false

# Only for LLM_PROVIDER=openai – leave empty in the repository.
OPENAI_API_KEY=

# AI images (optional, default off). Provider "fake" (offline placeholders) or "openai".
IMAGE_GENERATION_ENABLED=false
IMAGE_PROVIDER=fake
# Required for IMAGE_PROVIDER=openai (deliberate model choice, no default).
# Use a current gpt-image model of your account (e.g. gpt-image-2; gpt-image-1 no longer exists).
# List the available ones: uv run python -c "import openai; print([m.id for m in openai.OpenAI().models.list() if 'image' in m.id])"
IMAGE_MODEL=
# Cost brake: generations per post and per day, variants per generation (2-3).
IMAGE_MAX_PER_POST=3
IMAGE_MAX_PER_DAY=20
IMAGE_VARIANTS=3
# Cost estimate per image in EUR (audit and settings).
IMAGE_COST_PER_IMAGE_EUR=0.05

# Database connection (default: local SQLite file under data/, which is git-ignored).
DATABASE_URL=sqlite:///./data/posteingang.db
# Directory for raw incoming files (default: data/raw, git-ignored).
STORAGE_DIR=data/raw
# Retention period in days for finished items (deleted by "python -m app.cli purge").
RETENTION_DAYS=90

# IMAP test mailbox (optional, M11). Credentials only here, never in code.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true
