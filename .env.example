# Copy to .env and fill in locally. Never commit .env.

# Active industry profile (file profiles/<PROFILE>.yaml).
PROFILE=fitness

# LLM provider: "fake" (offline, deterministic) or "anthropic".
LLM_PROVIDER=fake
# Only for LLM_PROVIDER=anthropic – leave empty in the repository.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Database connection (default: local SQLite file under data/, which is git-ignored).
DATABASE_URL=sqlite:///./data/posteingang.db
# Directory for raw incoming files (default: data/raw, git-ignored).
STORAGE_DIR=data/raw
# Retention period for inbox items in days (deleted by "python -m app.cli purge").
RETENTION_DAYS=90

# IMAP test mailbox (optional, M11). Credentials only here, never in code.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SSL=true
