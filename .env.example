# Copy to .env and fill in locally. Never commit .env.
# LLM provider selection (implemented in M4): "fake" or a real provider name.
LLM_PROVIDER=fake
# API key for the real provider – leave empty for the demo with the fake provider.
LLM_API_KEY=
# Database connection (default: local SQLite file under data/, which is git-ignored).
DATABASE_URL=sqlite:///./data/posteingang.db
